# For running the backend on its own during development:  cp .env.example .env  (in backend/)
# In Docker, the settings come from the .env next to docker-compose.yml instead.

# postgres://user:pass@host:5432/db   → PostgreSQL (production)
# pglite:./.data                      → embedded Postgres saved in a folder (local development)
# (empty)                             → embedded in-memory Postgres (resets on restart)
DATABASE_URL=pglite:./.data
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
PORT=4000
PUBLIC_URL=http://localhost:5173
# Comma-separated web addresses allowed to call the API. Empty: any in development, PUBLIC_URL in production.
CORS_ORIGIN=
# Demo company with sample data (default on in development, off in production)
SEED_DEMO=1
SIMULATE=1
SIM_INTERVAL_MS=15000
# First start of an empty database: company and owner
COMPANY_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
TRUST_PROXY=
PUBLIC_ORG_SLUG=
ALLOW_COMPANY_SIGNUP=
WEBHOOK_ALLOW_PRIVATE=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
TZ=Asia/Kolkata
