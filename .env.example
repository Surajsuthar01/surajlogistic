# Copy to .env and fill in. Never commit the real .env.

# --- API ---
# postgres://user:pass@host:5432/db   → PostgreSQL (production)
# pglite:./.data                      → embedded Postgres saved in a folder (local dev, no install)
# (empty)                             → embedded in-memory Postgres (resets on restart)
DATABASE_URL=pglite:./.data
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
PORT=4000
# Where customers open tracking links (the web app's address)
PUBLIC_URL=http://localhost:5173
# Comma-separated list of web origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
# 1 = create the "Suraj Logistic" demo company on first start
SEED_DEMO=1
# 1 = move in-transit trucks with simulated GPS (turn off when real GPS devices report)
SIMULATE=1
SIM_INTERVAL_MS=15000
# Optional: lets Suraj Copilot rewrite its answers in natural language. The copilot works without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Keep dates and metro entry windows in Indian time
TZ=Asia/Kolkata

# --- Docker Compose ---
POSTGRES_PASSWORD=choose-a-strong-password
