# Surajlogistic settings for docker compose. Copy to .env and fill in:
#   cp .env.example .env
# (./deploy/setup.sh asks a few questions and writes this file for you.)
# Never share or commit the real .env.

# ---- Secrets: make each with  openssl rand -hex 32  (letters and numbers only) ----
POSTGRES_PASSWORD=
JWT_SECRET=

# ---- Your address ----
# Where people open the website and tracking links. With HTTPS: https://your-domain.in
PUBLIC_URL=http://localhost:8080
# Port on the server for the website (http). 8080 by default; 80 if nothing else uses it.
HTTP_PORT=8080
# For HTTPS: your domain, pointed at this server. Start with: docker compose --profile https up -d
DOMAIN=

# ---- Your company and the first owner login (used on the very first start only) ----
COMPANY_NAME=Suraj Logistic
COMPANY_PHONE=
COMPANY_CITY=
COMPANY_ADDRESS=
COMPANY_GSTIN=
ADMIN_NAME=
ADMIN_EMAIL=
# At least 8 characters. You can change it later in the app (Your profile).
ADMIN_PASSWORD=
ADMIN_PHONE=

# ---- Options ----
# 1 = also load the sample "Suraj Logistic" demo company with made-up data and logins
#     (password demo1234). For trying things out only; keep 0 on a real server.
SEED_DEMO=0
# 1 = move in-transit trucks on simulated GPS (demo only). Empty = on with demo data, off otherwise.
SIMULATE=
# 1 = let anyone create a new company from the website. Off: the site belongs to your company.
ALLOW_COMPANY_SIGNUP=
# Which company the public website books for, by its short name (slug). Empty = the first company.
PUBLIC_ORG_SLUG=
# Optional: lets the copilot write its answers in natural language. It works without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
